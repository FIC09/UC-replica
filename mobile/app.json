{
  "expo": {
    "name": "Forge India Connect",
    "slug": "fic-home-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.forgeindiaconnect.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to capture technician and service verification photos.",
        "NSPhotoLibraryUsageDescription": "This app accesses the photo library to upload service verification photos.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.forgeindiaconnect.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "INTERNET",
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "479c40d6-c09a-4d09-bba5-b71d593c58e9"
      }
    }
  }
}
