{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_BACKEND_URL": "https://uc-replica-dn4i.onrender.com",
        "EXPO_PUBLIC_RENDER_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_LAN_API_URL": "https://uc-replica-dn4i.onrender.com/api"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_BACKEND_URL": "https://uc-replica-dn4i.onrender.com",
        "EXPO_PUBLIC_RENDER_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_LAN_API_URL": "https://uc-replica-dn4i.onrender.com/api"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_BACKEND_URL": "https://uc-replica-dn4i.onrender.com",
        "EXPO_PUBLIC_RENDER_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_ANDROID_API_URL": "https://uc-replica-dn4i.onrender.com/api",
        "EXPO_PUBLIC_LAN_API_URL": "https://uc-replica-dn4i.onrender.com/api"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}

